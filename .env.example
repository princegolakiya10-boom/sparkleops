# ─────────────────────────────────────────────────────────────────
#  SparkleOps — Environment Variables
#  Copy this file to .env and fill in your Airtable credentials.
#  NEVER commit .env to git — it's already in .gitignore
# ─────────────────────────────────────────────────────────────────

# Your Airtable Personal Access Token
# Get it from: https://airtable.com/create/tokens
REACT_APP_AIRTABLE_TOKEN=your_personal_access_token_here

# Your Airtable Base ID
# Find it in: https://airtable.com/api — select your base, copy the ID (starts with "app")
REACT_APP_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
